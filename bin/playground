#!/usr/bin/env python3
"""Small, local experiment launcher; not the factory implementation."""
import os
from pathlib import Path
import shlex
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent
STATE = ROOT / '.playground'
SESSION = 'sumi-playground'
ENV = dict(os.environ, RAD_HOME=str(STATE / 'radicle'), RAD_PASSPHRASE='')

def run(*args, **kwargs):
    return subprocess.run(args, check=True, **kwargs)

def tmux(*args):
    return run('tmux', '-L', SESSION, *args)

def exists():
    return subprocess.run(['tmux', '-L', SESSION, 'has-session', '-t', SESSION],
                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0

def start():
    if exists():
        configure_keys()
        task_pane()
        print('Playground is already running.')
        return
    tmux('new-session', '-d', '-s', SESSION, '-n', 'work', '-c', str(STATE / 'demo'))
    configure_keys()
    tmux('set-environment', '-t', SESSION, 'RAD_HOME', str(STATE / 'radicle'))
    tmux('set-environment', '-t', SESSION, 'RAD_PASSPHRASE', '')
    tmux('set-option', '-t', SESSION, 'remain-on-exit', 'on')
    # Respawn the first shell so it inherits the isolated Radicle environment.
    tmux('respawn-pane', '-k', '-t', SESSION + ':work', '-c', str(STATE / 'demo'))
    tmux('split-window', '-h', '-t', SESSION + ':work', '-c', str(STATE / 'demo'))
    task_pane()
    command = shlex.join(['forgejo', 'web', '--work-path', str(STATE / 'forgejo'),
                         '--config', str(STATE / 'forgejo/app.ini')])
    tmux('new-window', '-t', SESSION, '-n', 'forgejo', command)
    tmux('select-window', '-t', SESSION + ':work')
    print('Started. Forgejo: http://127.0.0.1:3180')

def configure_keys():
    # Preserve modified Enter and other extended keys through the multiplexer.
    tmux('set-option', '-s', 'extended-keys', 'always')
    tmux('set-option', '-s', 'extended-keys-format', 'csi-u')
    tmux('set-option', '-s', 'terminal-features[10]', 'xterm-ghostty:extkeys')
    # Some agent CLIs leave the pane in VT10x mode. Forward the explicit
    # Shift+Enter CSI-u bytes instead of allowing legacy mode to erase Shift.
    tmux('bind-key', '-n', 'S-Enter', 'send-keys', '-H',
         '1b', '5b', '31', '33', '3b', '32', '75')
    # Leave Ctrl+B available for shell/TUI cursor movement.
    tmux('set-option', '-t', SESSION, 'prefix', 'C-g')
    tmux('bind-key', 'C-g', 'send-prefix')

def task_pane():
    panes = subprocess.check_output(
        ['tmux', '-L', SESSION, 'list-panes', '-t', SESSION + ':work',
         '-F', '#{pane_id} #{@sumi_role}'], text=True).splitlines()
    if any(line.endswith(' tasks') for line in panes):
        return
    target = panes[0].split()[0]
    pane = subprocess.check_output(
        ['tmux', '-L', SESSION, 'split-window', '-h', '-b', '-l', '30', '-d',
         '-t', target, '-P', '-F', '#{pane_id}', str(ROOT / 'bin/task-list')],
        text=True).strip()
    tmux('set-option', '-p', '-t', pane, '@sumi_role', 'tasks')

command = sys.argv[1] if len(sys.argv) > 1 else 'help'
if command == 'start':
    start()
elif command == 'attach':
    start()
    os.execvp('tmux', ['tmux', '-L', SESSION, 'attach-session', '-t', SESSION])
elif command == 'stop':
    if exists():
        tmux('kill-session', '-t', SESSION)
    subprocess.run(['tmux', '-L', 'sumi-artifact-viewer', 'kill-server'],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    print('Stopped playground panes and Forgejo; data is retained.')
elif command == 'rad':
    run('rad', *sys.argv[2:], cwd=STATE / 'demo', env=ENV)
elif command == 'status':
    print('tmux:', 'running' if exists() else 'stopped')
    run('rad', 'issue', 'list', cwd=STATE / 'demo', env=ENV)
elif command == 'tasks':
    if not exists():
        start()
    else:
        task_pane()
else:
    print('Usage: bin/playground {start|attach|stop|status|tasks|rad <arguments...>}')
